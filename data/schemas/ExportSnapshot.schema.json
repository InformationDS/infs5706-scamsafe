{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "caseVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "objectId": {
      "type": "string"
    },
    "objectVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "mode": {
      "type": "string",
      "const": "mock"
    },
    "contentApproval": {
      "type": "string",
      "const": "pending"
    },
    "review": {
      "type": "object",
      "properties": {
        "simulated": {
          "type": "boolean",
          "const": true
        },
        "label": {
          "type": "string",
          "const": "Training simulation only"
        }
      },
      "required": [
        "simulated",
        "label"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "caseId",
    "caseVersion",
    "objectId",
    "objectVersion",
    "title",
    "body",
    "synthetic",
    "mode",
    "contentApproval",
    "review",
    "dependencies"
  ],
  "additionalProperties": false
}
