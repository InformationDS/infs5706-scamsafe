{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "caseVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "objectId": {
      "type": "string"
    },
    "objectVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ]
    },
    "contentApproval": {
      "type": "string",
      "const": "pending"
    },
    "review": {
      "type": "object",
      "properties": {
        "simulated": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "simulated",
        "label",
        "actor",
        "reviewedAt"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    }
  },
  "required": [
    "caseId",
    "caseVersion",
    "objectId",
    "objectVersion",
    "title",
    "body",
    "synthetic",
    "mode",
    "contentApproval",
    "review",
    "dependencies",
    "schemaVersion"
  ],
  "additionalProperties": false
}
