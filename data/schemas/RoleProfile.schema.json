{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "organisation": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "contentApproval": {
      "type": "string",
      "const": "pending"
    },
    "enabled": {
      "type": "boolean",
      "const": false
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "id",
    "version",
    "organisation",
    "title",
    "permissions",
    "recipients",
    "contentApproval",
    "enabled",
    "synthetic"
  ],
  "additionalProperties": false
}
