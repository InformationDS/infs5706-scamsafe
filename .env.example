# Copy to .env and configure your own provider credentials.
# The assessment-provided key expires at the end of November 2026.
MODEL_MODE=live
MODEL_BASE_URL=https://provider.example/v1
MODEL_NAME=provider-model-name
MODEL_API_KEY=
MODEL_AUTH_HEADER=Authorization
MODEL_AUTH_SCHEME=Bearer
MODEL_TIMEOUT_MS=60000
PORT=4310
