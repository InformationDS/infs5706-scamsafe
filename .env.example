# Optional startup defaults. Prefer Configure model API in the app; saved local settings take precedence.
# Never place credentials in shared files or chat.
# mock is deterministic, offline and restricted to the fixed synthetic baseline.
MODEL_MODE=mock
# Enable live only after A authorizes any provider charges and data transfer.
# MiMo PAYG official example base: https://api.xiaomimimo.com/v1
# Third-party resellers / Token Plans may require a different base URL and matching key.
# Supply that provider's API base; do not append /chat/completions.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# OpenAI-compatible default. Change only to match your provider's documented authentication.
MODEL_AUTH_HEADER=Authorization
MODEL_AUTH_SCHEME=Bearer
MODEL_TIMEOUT_MS=30000
PORT=4310
