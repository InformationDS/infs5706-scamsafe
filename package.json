{
  "name": "scamsafe-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n service,ui \"tsx watch server/src/index.ts\" \"vite --host 127.0.0.1 --port 5173 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/src/index.ts",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "schemas": "tsx shared/write-schemas.ts",
    "fixtures": "tsx shared/write-fixtures.ts",
    "browser:install": "playwright install chromium",
    "check:browser": "tsx tests/browser-check.ts",
    "check:business": "tsx scripts/maintenance/check-business.ts",
    "check:module": "tsx tests/module-browser.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
